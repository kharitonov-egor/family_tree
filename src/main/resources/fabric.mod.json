{
  "schemaVersion": 1,
  "id": "familytree",
  "version": "${version}",
  "name": "Family Tree",
  "description": "See who bred whom. A family tree of your pets, horses, and farm animals, with each foal's stats against both parents, inherited colors, and PNG export.",
  "authors": ["egakh"],
  "icon": "assets/familytree/icon.png",
  "contact": {
    "homepage": "https://modrinth.com/mod/familytree",
    "sources": "https://github.com/kharitonov-egor/family_tree",
    "issues": "https://github.com/kharitonov-egor/family_tree/issues"
  },
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": ["com.egakh.familytree.fabric.FabricEntrypoint"],
    "client": ["com.egakh.familytree.client.fabric.FabricClientEntrypoint"],
    "jade": ["com.egakh.familytree.integration.jade.JadePlugin"],
    "journeymap": ["com.egakh.familytree.client.integration.journeymap.JourneyMapWaypoints"],
    "modmenu": ["com.egakh.familytree.client.fabric.ModMenuIntegration"]
  },
  "mixins": [
    "familytree.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=${loader}",
    "fabric-api": "*",
    "minecraft": "${minecraft}",
    "java": ">=${java}"
  }
}
